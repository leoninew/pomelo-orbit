# Pomelo Orbit 后端配置
#
# 开发环境：复制为 .env，并从仓库根目录启动服务。
# 指定环境：通过 OS env 设置 POMELO_ORBIT_APP__ENV=development，运行时读取 .env.development。
# 镜像环境：放到容器 <WORKDIR>/.env 或 <WORKDIR>/.env.<env>；当前 Dockerfile 的 WORKDIR 为 /app。
#
# 未指定环境：configs/config.yaml < .env < OS env。
# 指定环境：configs/config.yaml < configs/config.<env>.yaml < .env.<env> < OS env。
# .env.example 仅作模板，不参与运行时加载。

# 应用元数据
# POMELO_ORBIT_APP__NAME=Pomelo Orbit Backend Go
# POMELO_ORBIT_APP__VERSION=0.271.0
# POMELO_ORBIT_APP__DEBUG=false

# JWT 密钥（必填）
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# POMELO_ORBIT_JWT__SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# HTTP 服务（开发通常保持默认；镜像默认由 Dockerfile 设置为 0.0.0.0:80）
# POMELO_ORBIT_SERVER__HOST=127.0.0.1
# POMELO_ORBIT_SERVER__PORT=9021
# 跨域 API Origin allowlist。空值表示不开放跨域；多 Origin 使用逗号分隔。
# POMELO_ORBIT_SERVER__CORS_ALLOWED_ORIGINS=https://orbit.preflite.cn
# API path namespace。用于 CORS 与 API 404 判断；多 prefix 使用逗号分隔。
# POMELO_ORBIT_SERVER__API_PATH_PREFIXES=/api

# 前端运行时公开配置
# 公开 API URL 前缀。空值表示同源 /api；静态站点和 API 域名拆分时设置为 API origin 或路径前缀。
# POMELO_ORBIT_SERVER__PUBLIC_URL=https://orbit-api.preflite.cn

# Local Go stdio MCP credential. Create a MCP access token in the signed-in
# Orbit console, set it only in the Codex parent process environment, then
# restart the MCP session. Do not write a real token to this file or config.
# POMELO_ORBIT_MCP__ACCESS_TOKEN=

# 部署对话 LLM（OpenAI 兼容；BASE_URL、API_KEY、MODEL 必须同时配置）
# 未配置时，部署对话功能不可用。
# POMELO_ORBIT_LLM__BASE_URL=https://your-openai-compatible-provider.example/v1
# POMELO_ORBIT_LLM__API_KEY=replace-with-your-api-key
# POMELO_ORBIT_LLM__MODEL=your-model
# POMELO_ORBIT_LLM__TIMEOUT=60s
# Maximum LLM-to-MCP tool-call rounds for one deployment dialogue turn.
# POMELO_ORBIT_LLM__MAX_TOOL_CALL_ROUNDS=32

# 日志
# POMELO_ORBIT_LOGGING__LEVEL=info
# POMELO_ORBIT_LOGGING__FILE=logs/pomelo-orbit.log
# POMELO_ORBIT_LOGGING__MAX_SIZE_MB=100
# POMELO_ORBIT_LOGGING__MAX_BACKUPS=7
# POMELO_ORBIT_LOGGING__HTTP__ENABLED=false
# POMELO_ORBIT_LOGGING__HTTP__REQUEST_BODY_LIMIT=4096
# POMELO_ORBIT_LOGGING__HTTP__RESPONSE_BODY_LIMIT=4096
# POMELO_ORBIT_LOGGING__HTTP__SKIP_ASSET_ENABLED=true

# 数据库
# SQLite（默认）
# POMELO_ORBIT_DATABASE__DRIVER=sqlite
# POMELO_ORBIT_DATABASE__SQLITE__PATH=data/db/pomelo-orbit.db
# MySQL
# POMELO_ORBIT_DATABASE__DRIVER=mysql
# POMELO_ORBIT_DATABASE__MYSQL__DSN=user:password@tcp(127.0.0.1:3306)/pomelo_orbit?parseTime=true
# PostgreSQL
# POMELO_ORBIT_DATABASE__DRIVER=postgres
# POMELO_ORBIT_DATABASE__POSTGRES__DSN=postgres://user:password@127.0.0.1:5432/pomelo_orbit?sslmode=disable

# Orbit 运行根目录
# POMELO_ORBIT_ORBIT__ROOT=.

# CI 工作目录（相对路径相对 POMELO_ORBIT_ORBIT__ROOT）
# POMELO_ORBIT_WORKSPACE__ROOT=data

# Project initialization Wizard defaults only. Runtime values live on Environment / GatewayConfig.
# Keep ~ / ~/... as written; local runtime expands ~ to the control-plane user home when used.
# POMELO_ORBIT_PROJECT_INITIALIZATION__ENVIRONMENT__LOCAL_WORKSPACE_ROOT=~/.pomelo-orbit
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__IMAGE=traefik:3.6
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__REST_API_URL=http://localhost:8080
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__BASE_DOMAIN=lvh.me
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__REST_READY_TIMEOUT=20s
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__DEFAULT_ENTRYPOINT=web
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__TLS_MODE=none
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__ACME_PROFILE=
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__ACME_EMAIL=
# POMELO_ORBIT_PROJECT_INITIALIZATION__GATEWAY__DNS_API_TOKEN=

# Cloudflare Turnstile
# 生产必须在 Cloudflare Turnstile 控制台创建 widget，并覆盖真实 site key / secret key。
# POMELO_ORBIT_TURNSTILE__ENABLED=true
# POMELO_ORBIT_TURNSTILE__SITE_KEY=1x00000000000000000000AA
# POMELO_ORBIT_TURNSTILE__SECRET_KEY=1x0000000000000000000000000000000AA
# POMELO_ORBIT_TURNSTILE__VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Pipeline execution
# POMELO_ORBIT_PIPELINE_RUN__EXECUTION_TIMEOUT=1h

# Worker
# POMELO_ORBIT_WORKER__ID=default
# POMELO_ORBIT_WORKER__POLL_INTERVAL=1s
# POMELO_ORBIT_WORKER__LEASE_DURATION=1h5m
# POMELO_ORBIT_WORKER__MAX_ATTEMPTS=1
# POMELO_ORBIT_WORKER__CONCURRENCY=2
