# Pomelo Orbit - Multi-stage Dockerfile (CN mirror accelerated)

# Stage 1: Build web
FROM node:20-alpine AS web-builder

WORKDIR /app/web

# Copy web package files
COPY web/package.json web/yarn.lock ./

# Install dependencies (Taobao mirror)
RUN yarn config set registry https://registry.npmmirror.com \
    && yarn install --frozen-lockfile

# Copy web source
COPY web/ ./

# Build web
RUN yarn build

# Stage 2: Build backend
FROM golang:1.25-bookworm AS backend-builder

WORKDIR /app

# Use Go proxy mirror
ENV GOPROXY=https://goproxy.cn,direct

# Copy Go module files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy backend source
COPY cmd ./cmd
COPY internal ./internal
COPY sql ./sql

# Build backend binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/backend-go ./cmd/backend-go

# Stage 3: Final image
FROM debian:trixie-slim

WORKDIR /app

# Use Tsinghua apt mirror
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources

# Install system dependencies and docker CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    docker.io \
    docker-cli \
    docker-compose \
    && rm -rf /var/lib/apt/lists/* \
    && docker compose version

# Copy backend binary and configuration
COPY --from=backend-builder /out/backend-go /usr/local/bin/backend-go
COPY configs ./configs

# Copy web build from stage 1
COPY --from=web-builder /app/web/dist ./static

# Create runtime directories
RUN mkdir -p /app/data/db /app/logs

# Environment variables
ENV POMELO_ORBIT_SERVER__HOST=0.0.0.0
ENV POMELO_ORBIT_SERVER__PORT=80

# Expose port
EXPOSE 80

# Run the application. Override CMD with "worker" to run the background worker.
ENTRYPOINT ["backend-go"]
CMD ["serve"]
