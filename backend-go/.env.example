# Pomelo Orbit backend-go 配置
#
# 开发环境：复制为 backend-go/.env，并从 backend-go 目录启动服务。
# 镜像环境：放到容器 <WORKDIR>/.env；当前 Dockerfile 的 WORKDIR 为 /app。
#
# 配置优先级：config.defaults.yaml < config.local.yaml < .env < OS env。
# .env 不会覆盖 Docker/systemd/Kubernetes/CI 已注入的同名环境变量。

# JWT 密钥（必填）
# 生成方式：openssl rand -base64 32
POMELO_ORBIT_JWT__SECRET_KEY=your-fernet-key-here

# HTTP 服务（开发通常保持默认；镜像默认由 Dockerfile 设置为 0.0.0.0:80）
# POMELO_ORBIT_SERVER__HOST=127.0.0.1
# POMELO_ORBIT_SERVER__PORT=9001

# 日志
# POMELO_ORBIT_LOGGING__LEVEL=info
# POMELO_ORBIT_LOGGING__FILE=logs/backend-go.log
# POMELO_ORBIT_LOGGING__MAX_SIZE_MB=100
# POMELO_ORBIT_LOGGING__MAX_BACKUPS=7
# POMELO_ORBIT_LOGGING__HTTP_BODY_ENABLED=false
# POMELO_ORBIT_LOGGING__HTTP_BODY_MAX_BYTES=4096

# 数据库
# SQLite（默认）
# POMELO_ORBIT_DATABASE__DRIVER=sqlite
# POMELO_ORBIT_DATABASE__SQLITE__PATH=data/db/pomelo-orbit.db
# MySQL
# POMELO_ORBIT_DATABASE__DRIVER=mysql
# POMELO_ORBIT_DATABASE__MYSQL__DSN=user:password@tcp(127.0.0.1:3306)/pomelo_orbit?parseTime=true

# Orbit 运行根目录
# POMELO_ORBIT_ORBIT__ROOT=.

# Traefik
POMELO_ORBIT_TRAEFIK__API_URL=http://traefik:8080
POMELO_ORBIT_TRAEFIK__DOMAIN_SUFFIX=lvh.me
# POMELO_ORBIT_TRAEFIK__DYNAMIC_ROUTE_DIR=data/cd/traefik/data/dynamic
# POMELO_ORBIT_TRAEFIK__CERT_DIR=data/cd/traefik/data/certs
# POMELO_ORBIT_TRAEFIK__CONTAINER_NAME=traefik

# Cloudflare Turnstile
# 生产必须在 Cloudflare Turnstile 控制台创建 widget，并覆盖真实 site key / secret key。
POMELO_ORBIT_TURNSTILE__ENABLED=true
POMELO_ORBIT_TURNSTILE__SITE_KEY=1x00000000000000000000AA
POMELO_ORBIT_TURNSTILE__SECRET_KEY=1x0000000000000000000000000000000AA
# POMELO_ORBIT_TURNSTILE__VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Let's Encrypt 自动证书
# POMELO_ORBIT_CERT__LETSENCRYPT__ENABLED=false
# POMELO_ORBIT_CERT__LETSENCRYPT__EMAIL=your-email@example.com
# POMELO_ORBIT_CERT__LETSENCRYPT__CHALLENGE=http
# POMELO_ORBIT_CERT__LETSENCRYPT__DNS_PROVIDER=

# Worker
# POMELO_ORBIT_WORKER__ID=default
# POMELO_ORBIT_WORKER__POLL_INTERVAL=1s
# POMELO_ORBIT_WORKER__LEASE_DURATION=5m
# POMELO_ORBIT_WORKER__MAX_ATTEMPTS=3
# POMELO_ORBIT_WORKER__CONCURRENCY=2
