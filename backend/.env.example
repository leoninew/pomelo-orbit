# Pomelo Orbit 配置
# 复制此文件为 .env 并修改相应的值

# JWT 密钥 + 凭据加密密钥（必须使用 Fernet 格式）
# 生成方法: uv run --project backend python -c "import cryptography;from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POMELO_ORBIT_JWT__SECRET_KEY=00000000000000000000000000000000000000000000

# 证书配置
POMELO_ORBIT_CERT__LETSENCRYPT__ENABLED=false
POMELO_ORBIT_CERT__LETSENCRYPT__EMAIL=your-email@example.com
POMELO_ORBIT_CERT__LETSENCRYPT__CHALLENGE=http

# Traefik 配置
POMELO_ORBIT_TRAEFIK__DOMAIN_SUFFIX=lvh.me
