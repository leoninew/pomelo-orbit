        "id": "01STAGE000000000000000CLONE",
        "name": "git clone",
        "image": "alpine/git",
        "script": "set -e\ngit init\ngit remote remove origin 2>/dev/null || true\ngit remote add origin {{ repository_url }}\ngit fetch --depth=1 origin {{ repository_ref }}\ngit checkout -B {{ repository_ref }} FETCH_HEAD",
        "artifacts": null,
        "description": "克隆代码仓库",
        "version": 2
      },
      {
        "id": "01KNRANZDR4PASATAXKTBBTRX9",
        "name": "golang:1.23 test",
        "image": "golang:1.23-alpine",
        "script": "set -e\ncd {{ working_dir | default('.') }}\ngo test ./...",
        "artifacts": null,
        "description": "运行 Go 单元测试",
        "version": 2
      },
      {
        "id": "01KNRDSSJ7RNND7110175N4NR2",
        "name": "golang:1.23 build",
        "image": "golang:1.23-alpine",
        "script": "set -e\ncd {{ working_dir | default('.') }}\nmkdir -p dist\ngo build -o dist/",
        "artifacts": null,
        "description": "运行 Go 构建",
        "version": 2
      },
      {
        "id": "01KNRKNAHG3EBS07VBK2YY5ZQN",
        "name": "golang:1.23 lint",
        "image": "golang:1.23-alpine",
        "script": "set -e\ncd {{ working_dir | default('.') }}\ngo install golang.org/x/lint/golint@latest\ngolint ./...",
        "artifacts": null,
        "description": "运行 Go 代码质量",
        "version": 2
      },
      {
        "id": "01KP0K4ZTV60PM2XDT11MTX2MY",
        "name": "docker build",
        "image": "docker:29.4",
        "script": "set -e\ndocker build -t {{ repository_name }} {{ working_dir | default('.') }}\n# docker push {{ repository_name }}",
        "artifacts": "[{\"type\": \"docker_image\", \"path\": \"{{ repository_name }}\", \"name\": \"{{ repository_name }}\"}]",
        "description": "通用镜像构建+推送",
        "version": 11
      }
    ],
