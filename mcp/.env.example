# Orbit HTTP API base URL
POMELO_ORBIT_URL=http://localhost:9201

# Existing Orbit login credentials. Do not commit real values.
POMELO_ORBIT_USERNAME=
POMELO_ORBIT_PASSWORD=

# Optional process-provided JWT. Leave empty for the managed local cache.
POMELO_ORBIT_JWT=

# Optional override for the directory visible to this Docker CLI where Orbit writes deployment workspaces.
# Defaults to the repository-relative data directory and creates it when absent.
# POMELO_ORBIT_DATA_ROOT=../data

# Optional Docker context. Leave empty to use the Docker CLI default.
POMELO_ORBIT_DOCKER_CONTEXT=

# Optional deployment observation settings.
POMELO_ORBIT_WAIT_TIMEOUT_SECONDS=300
POMELO_ORBIT_STABILITY_WINDOW_SECONDS=60
POMELO_ORBIT_STABILITY_POLL_SECONDS=2
