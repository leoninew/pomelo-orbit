# SSH 连接配置（必填）
SSH_HOST=your-server-ip
SSH_USER=root
# ssh $SSH_USER@$SSH_HOST

# 远程端口（必填，ssh-tunnel.sh 依赖此变量）
REMOTE_PORT=9003

# 远程部署目录（必填）
REMOTE_DEPLOY_DIR=/opt/pomelo-orbit

# 上游仓库路径
SOURCE_REPO=/Volumes/media/SourceCodes/pomelo-orbit

# * 表示当前分支，main 等具体分支表示验证是否匹配
SOURCE_BRANCH=*

# GitHub Container Registry 访问令牌（可选，拉取私有镜像需要）
# 在 https://github.com/settings/tokens 生成 Classic Token，权限勾选 read:packages
# 留空则跳过 docker login（适用于公开镜像或已手动登录的服务器）
# GHCR_TOKEN=ghp_xxxxxxxxxxxx

# Docker 镜像（可选，脚本本地变量，不会写入远端应用 .env）
# POMELO_ORBIT_IMAGE=ghcr.io/leoninew/pomelo-orbit:latest

# ===== Pomelo Orbit 应用配置 =====
# 以下 POMELO_ORBIT_ 开头的变量会写入远端 $REMOTE_DEPLOY_DIR/.env。
# POMELO_ORBIT_IMAGE 除外：它只用于部署脚本选择镜像。

# JWT 密钥（Fernet 格式，必填，必须替换）
# 生成示例：python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
POMELO_ORBIT_JWT__SECRET_KEY=your-fernet-key-here

# Traefik API 地址（可选，默认 http://traefik:8080）
# POMELO_ORBIT_TRAEFIK__API_URL=http://traefik:8080
# POMELO_ORBIT_TRAEFIK__DOMAIN_SUFFIX=lvh.me

# Cloudflare Turnstile（生产建议配置真实 key）
# 默认 configs/config.yaml 中的 Cloudflare test keys 不提供生产防护。
POMELO_ORBIT_TURNSTILE__ENABLED=true
POMELO_ORBIT_TURNSTILE__SITE_KEY=your-cloudflare-turnstile-site-key
POMELO_ORBIT_TURNSTILE__SECRET_KEY=your-cloudflare-turnstile-secret-key
# POMELO_ORBIT_TURNSTILE__VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# 数据库（默认 SQLite；MySQL 按需启用）
# POMELO_ORBIT_DATABASE__DRIVER=sqlite
# POMELO_ORBIT_DATABASE__SQLITE__PATH=data/db/pomelo-orbit.db
# POMELO_ORBIT_DATABASE__DRIVER=mysql
# POMELO_ORBIT_DATABASE__MYSQL__DSN=user:password@tcp(mysql:3306)/pomelo_orbit?parseTime=true

# Let's Encrypt 自动证书（可选，公网域名使用）
# POMELO_ORBIT_CERT__LETSENCRYPT__ENABLED=true
# POMELO_ORBIT_CERT__LETSENCRYPT__EMAIL=your@email.com
# POMELO_ORBIT_CERT__LETSENCRYPT__CHALLENGE=http
# POMELO_ORBIT_CERT__LETSENCRYPT__DNS_PROVIDER=
