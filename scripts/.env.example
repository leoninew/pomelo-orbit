# SSH 连接配置（manage.py 必填）
SSH_HOST=your-server-ip
SSH_USER=root
# ssh $SSH_USER@$SSH_HOST

# 远程部署目录（manage.py 必填）
REMOTE_DEPLOY_DIR=/opt/pomelo-orbit

# GitHub Container Registry 访问令牌（manage.py 可选，拉取私有镜像需要）
# 在 https://github.com/settings/tokens 生成 Classic Token，权限勾选 read:packages。
# 留空则跳过 docker login（适用于公开镜像或已手动登录的服务器）。
# GHCR_TOKEN=ghp_xxxxxxxxxxxx

# 数据库管理员连接（database_reset.py 必填）
# 格式：postgresql+psycopg://用户名:密码@主机:端口/管理库?sslmode=disable
# 主机可以是本机、容器服务名或远程 PostgreSQL 主机。
DB_ADMIN_DSN=postgresql+psycopg://postgres:your-postgres-admin-password@127.0.0.1:5432/postgres?sslmode=disable

# 目标数据库账号（database_reset.py 必填）
TARGET_DATABASE=pomelo_orbit
TARGET_USERNAME=orbit
TARGET_PASSWORD=your-orbit-password
