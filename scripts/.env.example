# Pomelo Orbit CLI configuration (all values are optional until their command is used).
# make run: copy to scripts/.env.development (default profile).
# Direct uv run without POMELO_ORBIT_APP__ENV: copy to scripts/.env.
# Select another profile through the process environment POMELO_ORBIT_APP__ENV.
# Process environment variables take precedence over this file.

POMELO_ORBIT_LOGGING__LEVEL=INFO

# Orbit project environments: service root and PAT from the Orbit console.
POMELO_ORBIT_CLI__BASE_URL=https://orbit.example.com
POMELO_ORBIT_MCP__ACCESS_TOKEN=

# Direct OpenSSH commands (remote ssh/exec/scp/tunnel start).
POMELO_ORBIT_SSH__HOST=your-server-ip
POMELO_ORBIT_SSH__USER=root
