# Release runtime overrides. The packaged launchers load this file as .env.release.
# All unspecified settings use configs/config.yaml; .env.example is the complete reference.

# Bind the packaged UI and API on every interface.
POMELO_ORBIT_SERVER__HOST=0.0.0.0
POMELO_ORBIT_SERVER__PORT=9023

# Local MCP browser authorization follows the packaged server port.
POMELO_ORBIT_MCP__API_URL=http://127.0.0.1:9023
POMELO_ORBIT_MCP__WEB_URL=http://localhost:9023

# Development-friendly local runtime settings.
POMELO_ORBIT_LOGGING__HTTP__ENABLED=true
POMELO_ORBIT_DATABASE__DRIVER=sqlite
POMELO_ORBIT_DATABASE__SQLITE__PATH=data/db/pomelo-orbit.db

# CI/CD 工作目录（相对路径相对 POMELO_ORBIT_ORBIT__ROOT；两者不得相同或嵌套）
POMELO_ORBIT_WORKSPACE__PIPELINE=data/pipeline
POMELO_ORBIT_WORKSPACE__DEPLOYMENT=data/deployment


# Do not commit credentials. Set these in the package-root .env or OS environment.
# POMELO_ORBIT_JWT__SECRET_KEY=
# POMELO_ORBIT_LLM__BASE_URL=
# POMELO_ORBIT_LLM__API_KEY=
# POMELO_ORBIT_LLM__MODEL=

# The packaged local instance does not require a Turnstile widget.
POMELO_ORBIT_TURNSTILE__ENABLED=false
