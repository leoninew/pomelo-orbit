{
  "schema_version": 1,
  "contract_path": "skills/deploy-ragflow-integrated-orbit/deployment-contract.json",
  "primitive_path": "skills/deploy-ragflow-integrated-orbit/references/ragflow-integrated-components.md",
  "primitive_title": "RAGFlow Integrated Deployment Primitives",
  "primitive_description": "Use this reference before an integrated RAGFlow `pomelo_delivery` write. The contract is the only hand-maintained source for integrated topology configuration.",
  "network": {
    "name": "traefik",
    "external": true
  },
  "compose_header": [
    "CPU reference for the default Orbit deployment mode: one RAGFlow Application with six Components.",
    "Do not use this file when the user explicitly requests split applications.",
    "Each bundled component owns a separate directory directly below the Service workspace."
  ],
  "model_cache_paths": [
    "data/deployment/<service-code>/tei/cache/bge-m3"
  ],
  "runtime_config": {
    "name": "IntegratedRuntimeConfig",
    "keys": [
      "MYSQL_PASSWORD",
      "REDIS_PASSWORD",
      "MINIO_USER",
      "MINIO_PASSWORD",
      "ELASTIC_PASSWORD"
    ],
    "assignments": [
      {"component": "mysql", "keys": ["MYSQL_PASSWORD"]},
      {"component": "redis", "keys": ["REDIS_PASSWORD"]},
      {"component": "minio", "keys": ["MINIO_USER", "MINIO_PASSWORD"]},
      {"component": "es01", "keys": ["ELASTIC_PASSWORD"]},
      {
        "component": "ragflow-cpu",
        "keys": [
          "MYSQL_PASSWORD",
          "REDIS_PASSWORD",
          "MINIO_USER",
          "MINIO_PASSWORD",
          "ELASTIC_PASSWORD"
        ]
      }
    ]
  },
  "applications": [
    {
      "code": "ragflow-integrated",
      "service": "default",
      "versions": [
        {
          "role": "RAGFlow Integrated CPU",
          "label": "ragflow-integrated-cpu",
          "components": ["mysql", "redis", "minio", "es01", "tei", "ragflow-cpu"],
          "hostname_component": "ragflow-cpu"
        },
        {
          "role": "RAGFlow Integrated GPU",
          "label": "ragflow-integrated-gpu",
          "components": ["mysql", "redis", "minio", "es01", "tei", "ragflow-cpu"],
          "hostname_component": "ragflow-cpu"
        }
      ]
    }
  ],
  "components": [
    {
      "name": "mysql",
      "application": "ragflow-integrated",
      "compose_file": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.yml",
      "service_name": "mysql",
      "image": "mysql:8.0.39",
      "command": [
        "--max_connections=1000",
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci",
        "--default-authentication-plugin=mysql_native_password",
        "--tls_version=TLSv1.2,TLSv1.3",
        "--binlog_expire_logs_seconds=604800"
      ],
      "environment": [
        {"key": "MYSQL_DATABASE", "value": "rag_flow"},
        {"key": "MYSQL_ROOT_HOST", "value": "%"},
        {"key": "MYSQL_ROOT_PASSWORD", "runtime_key": "MYSQL_PASSWORD"}
      ],
      "mounts": [
        {"type": "bind", "source": "./mysql", "target": "/var/lib/mysql", "logical_source": "mysql"}
      ],
      "network_alias": "ragflow-mysql",
      "healthcheck": {
        "test": ["CMD-SHELL", "mysqladmin ping -uroot -p\"$${MYSQL_ROOT_PASSWORD}\""],
        "interval": "10s",
        "timeout": "10s",
        "retries": 120
      },
      "endpoints": [
        {"name": "mysql", "protocol": "tcp", "container_port": 3306, "mode": "internal"}
      ],
      "restart": "unless-stopped"
    },
    {
      "name": "redis",
      "application": "ragflow-integrated",
      "compose_file": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.yml",
      "service_name": "redis",
      "image": "valkey/valkey:8",
      "command": ["sh", "-c", "exec redis-server --requirepass \"$${REDIS_PASSWORD}\" --maxmemory 128mb --maxmemory-policy allkeys-lru"],
      "environment": [
        {"key": "REDIS_PASSWORD", "runtime_key": "REDIS_PASSWORD"}
      ],
      "mounts": [
        {"type": "bind", "source": "./redis", "target": "/data", "logical_source": "redis"}
      ],
      "network_alias": "ragflow-redis",
      "healthcheck": {
        "test": ["CMD-SHELL", "redis-cli -a \"$${REDIS_PASSWORD}\" ping"],
        "interval": "10s",
        "timeout": "10s",
        "retries": 120
      },
      "endpoints": [
        {"name": "redis", "protocol": "tcp", "container_port": 6379, "mode": "internal"}
      ],
      "restart": "unless-stopped"
    },
    {
      "name": "minio",
      "application": "ragflow-integrated",
      "compose_file": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.yml",
      "service_name": "minio",
      "image": "pgsty/minio:RELEASE.2026-03-25T00-00-00Z",
      "command": ["server", "--console-address", ":9001", "/data"],
      "environment": [
        {"key": "MINIO_ROOT_USER", "runtime_key": "MINIO_USER"},
        {"key": "MINIO_ROOT_PASSWORD", "runtime_key": "MINIO_PASSWORD"}
      ],
      "mounts": [
        {"type": "bind", "source": "./minio", "target": "/data", "logical_source": "minio"}
      ],
      "network_alias": "ragflow-minio",
      "healthcheck": {
        "test": ["CMD", "curl", "-fsS", "http://localhost:9000/minio/health/live"],
        "interval": "10s",
        "timeout": "10s",
        "retries": 120
      },
      "endpoints": [
        {"name": "api", "protocol": "http", "container_port": 9000, "mode": "internal"}
      ],
      "restart": "unless-stopped"
    },
    {
      "name": "es01",
      "application": "ragflow-integrated",
      "compose_file": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.yml",
      "service_name": "es01",
      "image": "elasticsearch:8.11.3",
      "environment": [
        {"key": "ELASTIC_PASSWORD", "runtime_key": "ELASTIC_PASSWORD"},
        {"key": "node.name", "value": "es01"},
        {"key": "bootstrap.memory_lock", "value": "false"},
        {"key": "discovery.type", "value": "single-node"},
        {"key": "xpack.security.enabled", "value": "true"},
        {"key": "xpack.security.http.ssl.enabled", "value": "false"},
        {"key": "xpack.security.transport.ssl.enabled", "value": "false"},
        {"key": "cluster.routing.allocation.disk.watermark.low", "value": "5gb"},
        {"key": "cluster.routing.allocation.disk.watermark.high", "value": "3gb"},
        {"key": "cluster.routing.allocation.disk.watermark.flood_stage", "value": "2gb"}
      ],
      "mounts": [
        {"type": "bind", "source": "./es01", "target": "/usr/share/elasticsearch/data", "logical_source": "es01"}
      ],
      "tmpfs": ["/tmp:size=536870912,mode=1777"],
      "ulimits": {
        "memlock": {"soft": -1, "hard": -1}
      },
      "deploy": {
        "resources": {
          "limits": {"memory": "8g"}
        }
      },
      "network_alias": "ragflow-es01",
      "healthcheck": {
        "test": ["CMD-SHELL", "curl -fsS -u \"elastic:$${ELASTIC_PASSWORD}\" http://localhost:9200"],
        "interval": "10s",
        "timeout": "10s",
        "retries": 120
      },
      "endpoints": [
        {"name": "http", "protocol": "http", "container_port": 9200, "mode": "internal"}
      ],
      "restart": "unless-stopped"
    },
    {
      "name": "tei",
      "application": "ragflow-integrated",
      "compose_file": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.yml",
      "service_name": "tei",
      "images": {
        "cpu": "ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3@sha256:ad950d30878eceb72aaf32024d26fa2b1d04a75304fa0b4776b49aa1941fea07",
        "gpu": "ghcr.io/huggingface/text-embeddings-inference:cuda-1.9.3@sha256:249a0bc87522bfe2f1012b4d194f0225878f47079115ada3aeb0b1ef257b402a"
      },
      "command": ["--model-id", "/data/bge-m3", "--json-output"],
      "mounts": [
        {"type": "bind", "source": "./tei/cache", "target": "/data", "logical_source": "tei/cache"}
      ],
      "network_alias": "ragflow-tei",
      "healthcheck": {
        "test": ["CMD-SHELL", "curl -fsS http://127.0.0.1:80/health"],
        "interval": "30s",
        "timeout": "5s",
        "retries": 10,
        "start_period": "5m"
      },
      "endpoints": [
        {"name": "http", "protocol": "http", "container_port": 80, "mode": "internal"}
      ],
      "profile_overrides": {
        "gpu": {
          "deploy": {
            "resources": {
              "reservations": {
                "devices": [
                  {"driver": "nvidia", "count": "all", "capabilities": ["gpu"]}
                ]
              }
            }
          }
        }
      },
      "restart": "unless-stopped"
    },
    {
      "name": "ragflow-cpu",
      "application": "ragflow-integrated",
      "compose_file": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.yml",
      "service_name": "ragflow-cpu",
      "image": "infiniflow/ragflow:v0.26.4",
      "command": ["--enable-adminserver", "--init-model-provider-tables"],
      "environment": [
        {"key": "DOC_ENGINE", "value": "elasticsearch"},
        {"key": "DEVICE", "value": "cpu"},
        {"key": "API_PROXY_SCHEME", "value": "python"},
        {"key": "TZ", "value": "Asia/Shanghai"},
        {"key": "MYSQL_HOST", "value": "mysql"},
        {"key": "MYSQL_PORT", "value": "3306"},
        {"key": "MYSQL_DBNAME", "value": "rag_flow"},
        {"key": "MYSQL_USER", "value": "root"},
        {"key": "MYSQL_PASSWORD", "runtime_key": "MYSQL_PASSWORD"},
        {"key": "MYSQL_MAX_PACKET", "value": "1073741824"},
        {"key": "REDIS_HOST", "value": "redis"},
        {"key": "REDIS_PASSWORD", "runtime_key": "REDIS_PASSWORD"},
        {"key": "MINIO_HOST", "value": "minio"},
        {"key": "MINIO_USER", "runtime_key": "MINIO_USER"},
        {"key": "MINIO_PASSWORD", "runtime_key": "MINIO_PASSWORD"},
        {"key": "ES_HOST", "value": "es01"},
        {"key": "ES_USER", "value": "elastic"},
        {"key": "ELASTIC_PASSWORD", "runtime_key": "ELASTIC_PASSWORD"}
      ],
      "depends_on": {
        "mysql": {"condition": "service_healthy"},
        "redis": {"condition": "service_healthy"},
        "minio": {"condition": "service_healthy"},
        "es01": {"condition": "service_healthy"},
        "tei": {"condition": "service_healthy"}
      },
      "mounts": [
        {"type": "bind", "source": "./ragflow/logs", "target": "/ragflow/logs", "logical_source": "ragflow/logs"}
      ],
      "network_alias": "ragflow-ragflow-cpu",
      "healthcheck": {
        "test": ["CMD", "curl", "-fsS", "http://localhost:80/"],
        "interval": "10s",
        "timeout": "10s",
        "retries": 120
      },
      "endpoints": [
        {"name": "http", "protocol": "http", "container_port": 80, "mode": "gateway", "entrypoint": "web"}
      ],
      "restart": "unless-stopped"
    }
  ],
  "compose_targets": [
    {
      "path": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.yml",
      "components": ["mysql", "redis", "minio", "es01", "tei", "ragflow-cpu"],
      "header": [
        "Combine with docker-compose.gpu.yml to reproduce the GPU TEI variant on an NVIDIA-capable host."
      ]
    },
    {
      "path": "skills/deploy-ragflow-integrated-orbit/references/docker-compose.gpu.yml",
      "profile": "gpu",
      "components": ["tei"],
      "overlay": true,
      "header": [
        "GPU overlay for the bundled RAGFlow + TEI Compose reference.",
        "Use only on a host with NVIDIA Driver and NVIDIA Container Toolkit.",
        "Orbit lifecycle operations remain MCP-only."
      ]
    }
  ],
  "manual_provider": {
    "name": "tei-bge-m3",
    "model": "BAAI/bge-m3",
    "tei_base_url": "http://tei:80",
    "max_tokens": 8192
  }
}
