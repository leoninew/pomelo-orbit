{
  "name": "pomelo-orbit-web",
  "description": "",
  "version": "0.317.2",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm monaco:assets && vite",
    "build": "corepack pnpm monaco:assets && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --fix --fix-type=problem --cache",
    "format": "prettier src --check --ignore-unknown",
    "format:fix": "prettier src --write --ignore-unknown",
    "monaco:assets": "node scripts/copy-monaco-assets.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@lucide/vue": "1.70.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "axios": "^1.6.2",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.10",
    "dompurify": "3.2.7",
    "marked": "14.0.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^2.1.7",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-i18n": "9",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/dagre": "^0.7.54",
    "@vitejs/plugin-vue": "6.0.7",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "20.0.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.63.0",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.6"
  }
}
